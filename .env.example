# --- OpenRouter -------------------------------------------------------------
# Fallback key, used only when the caller sends no Authorization header.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution shown on openrouter.ai/rankings
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# --- Statewave --------------------------------------------------------------
STATEWAVE_URL=http://localhost:8000
STATEWAVE_API_KEY=
# Pinned tenant; when set, overrides any client X-Tenant-ID header
STATEWAVE_TENANT_ID=
# Token budget for the injected context bundle
STATEWAVE_CONTEXT_TOKENS=1500
# Kick an async compile after every turn (1/true/yes)
STATEWAVE_COMPILE_AFTER_TURN=
# `source` recorded on written episodes
STATEWAVE_EPISODE_SOURCE=openrouter-proxy
# Caller identity sent on every retrieval. Statewave policy rules match on
# these; tenants with `require_caller_identity` reject calls without them.
STATEWAVE_CALLER_TYPE=openrouter-gateway
STATEWAVE_CALLER_ID=

# --- Proxy ------------------------------------------------------------------
PROXY_TIMEOUT=120
# Container only: the port uvicorn binds inside the image. Ignored when you
# run uvicorn yourself and pass --port.
PORT=8080
# HS256 secret for verifying inbound `X-Statewave-Token` JWTs. Set it and every
# chat call needs a valid token, and the subject is read from the token's `sub`
# claim instead of the X-Statewave-Subject header. Tokens must carry an `exp`
# claim; one without it is rejected.
PROXY_JWT_SECRET=
# Trust the caller-supplied X-Statewave-Subject header/body field. Needed for a
# single-tenant deploy with no token; with a token set, lets a trusted gateway
# override the token's subject. 1/true/yes.
STATEWAVE_TRUST_CLIENT_SUBJECT=
